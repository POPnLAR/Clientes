# Plantilla de Secrets (NO contiene valores reales). Cópiala en Streamlit Cloud:
# Manage app -> Settings -> Secrets. En local, guárdala como .streamlit/secrets.toml (está ignorado por git).
#
# IMPORTANTE (TOML): las claves sueltas de abajo (EVO_URL, ALLOWED_EMAILS, etc.) deben ir ANTES de la
# sección [auth]; todo lo que quede después de un encabezado [auth] pertenece a esa sección.

# --- Quién puede entrar al panel (separados por coma) ---
ALLOWED_EMAILS = "tu-correo@gmail.com"

# --- Lo que ya usaba la app ---
EVO_URL = "https://gestionvitalpro.cl/evolution"
EVO_TOKEN = "..."
EVO_INSTANCE = "GestionVital"
GITHUB_TOKEN = "..."
GITHUB_REPO = "POPnLAR/Clientes"
AGENT_SERVICE_URL = "https://gestionvitalpro.cl/agente-api"
AGENT_SERVICE_TOKEN = "..."

# --- Login con Google (OIDC de Streamlit) ---
[auth]
# Debe coincidir EXACTAMENTE con una "URI de redireccionamiento autorizada" del cliente OAuth de Google:
redirect_uri = "https://TU-APP.streamlit.app/oauth2callback"
# Cadena aleatoria larga:  python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "..."
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
